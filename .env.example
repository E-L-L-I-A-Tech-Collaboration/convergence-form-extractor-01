# Required for persistent accounts and subscription entitlements. Use a managed
# PostgreSQL connection string, such as Vercel Postgres or Neon.
DATABASE_URL=

# Optional. Required only for AI-assisted creativity features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
PORT=3000

# Google Play Store Distribution & App URL
APP_URL=http://localhost:3000
GOOGLE_PLAY_PACKAGE_NAME=com.axiomzetainnovations.convergenceform
# Generate with: openssl rand -base64 48
BILLING_COOKIE_SECRET=
