  "description": "Convergence Form Extractor: An interactive platform that monitors, assesses, and enhances generative human creativity with AI assistance, augmented by cognitive HRM modeling and a verification ledger under the hood.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "window-controls-overlay"],
  "orientation": "any",
  "dir": "ltr",
  "theme_color": "#07101d",
  "background_color": "#ffffff",
  "lang": "en-US",
  "categories": ["health", "lifestyle", "productivity", "education"],
  "prefer_related_applications": false,
